#!/usr/bin/env bash
# shellcheck disable=SC2154
set -eo pipefail; shopt -s inherit_errexit

DOC="Run scripts against a host's prebuilt VM under the NixOS test driver
Usage:
  vm-test run [-i INPUT]... HOST [SCRIPT]
  vm-test start [-i INPUT]... HOST
  vm-test exec HOST [SCRIPT]
  vm-test stop HOST

run: Boot, run SCRIPT (default: nix/tests/HOST-prebuilt.py), shut down.
start: Boot and keep the machines running for exec, until stop.
exec: Run SCRIPT (default: stdin) in the running driver and print its log.
State and logs go in ~/.cache/vm-test/<checkout>-HOST/.

Options:
  -i, --input INPUT  Build with a local checkout for a flake input, as
                     NAME=PATH (tracked files, uncommitted changes included)
"
