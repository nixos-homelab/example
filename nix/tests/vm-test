"$p$varname";done;done;}
# docopt parser above, complete command for generating this parser is `docopt.sh vm-test`

main() {
  eval "$(docopt "$@")"
  # Outside the checkout: below a worktree the VM's swtpm socket path passes the 108-byte limit
  local dir tests
  dir=${XDG_CACHE_HOME:-$HOME/.cache}/vm-test/$(realpath . | sha256sum | cut -c1-8)-$HOST
  tests=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
  running() { [[ -f $dir/pid ]] && kill -0 "$(<"$dir/pid")" 2>/dev/null; }
  if $run || $start; then
    ! running || { printf "A driver for %s is already running (vm-test stop %s)\n" "$HOST" "$HOST" >&2; return 1; }
    local system check driver conf input overrides=()
    for input in "${__input[@]}"; do
      overrides+=(--override-input "${input%%=*}" "git+file://$(realpath "${input#*=}")")
    done
    system=$(nix eval --raw --impure --expr builtins.currentSystem)
    check=".#checks.$system.$HOST-prebuilt"
    driver=$(nix build --no-link --print-out-paths "${overrides[@]}" "$check.driver")
    conf=$(nix build --no-link --print-out-paths "${overrides[@]}" "$check.config.driverConfigurationFile")
    mkdir -p "$dir"
    # The driver keeps its machines' state and sockets under XDG_RUNTIME_DIR
    export XDG_RUNTIME_DIR=$dir PYTHONUNBUFFERED=1
    jq --arg s "$dir/test-script.py" '.test_script = $s' "$conf" >"$dir/config.json"
  fi
  if $run; then
    cat "$tests/prelude.py" "${SCRIPT:-nix/tests/$HOST-prebuilt.py}" >"$dir/test-script.py"
    printf "%d\n" $$ >"$dir/pid"
    exec "$driver/bin/nixos-test-driver" --config "$dir/config.json" -o "$dir"
  elif $start; then
    rm -f "$dir/in" "$dir/out"
    mkfifo "$dir/in" "$dir/out"
    cat "$tests/prelude.py" "$tests/serve.py" >"$dir/test-script.py"
    VM_TEST_DIR=$dir VM_TEST_HOST=$HOST setsid "$driver/bin/nixos-test-driver" --config "$dir/config.json" -o "$dir" >"$dir/driver.log" 2>&1 &
    printf "%d\n" $! >"$dir/pid"
    await_status >/dev/null || { tail -20 "$dir/driver.log" >&2; return 1; }
    printf "%s started, log: %s\n" "$HOST" "$dir/driver.log"
  elif $exec; then
    running || { printf "No driver for %s is running (vm-test start %s)\n" "$HOST" "$HOST" >&2; return 1; }
    local offset status code
    code=$(cat "${SCRIPT:--}")
    offset=$(stat -c %s "$dir/driver.log")
    timeout 10 tee "$dir/in" <<<"$code" >/dev/null
    status=$(await_status) || true
    tail -c +$((offset + 1)) "$dir/driver.log"
    [[ $status = ok ]]
  elif $stop; then
    if running; then
      timeout 10 tee "$dir/in" <<<"raise SystemExit" >/dev/null || true
      timeout 30 tail --pid "$(<"$dir/pid")" -f /dev/null || kill "$(<"$dir/pid")"
    fi
    rm -f "$dir/in" "$dir/out" "$dir/pid"
  fi
}

# Print what the driver writes to the out FIFO, fail if the driver exits first
await_status() {
  cat "$dir/out" & local reader=$!
  while kill -0 $reader 2>/dev/null; do
    running || { kill $reader; return 1; }
    sleep 1
  done
  wait $reader
}

main "$@"
